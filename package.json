{
  "name": "pi-herdr-session-fork",
  "version": "0.1.0",
  "description": "Fork a Pi conversation stage into a named herdr-app tab using herdr-core, while keeping the original session active.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1am2syman/pi-herdr-session-fork.git"
  },
  "homepage": "https://github.com/1am2syman/pi-herdr-session-fork#readme",
  "bugs": {
    "url": "https://github.com/1am2syman/pi-herdr-session-fork/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "herdr",
    "herdr-core",
    "herdr-app",
    "session",
    "fork"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/herdr-fork.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:core": "node --experimental-strip-types --test test/core.integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
